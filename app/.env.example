# Copy to .env.local for development. Never commit real values.

# Supabase (Project settings > API keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # server only

# Plaid (dashboard.plaid.com > Developers > Keys)
PLAID_CLIENT_ID=
PLAID_SECRET=                                 # the secret for PLAID_ENV
PLAID_ENV=sandbox                             # sandbox | production
PLAID_WEBHOOK_URL=                            # optional, e.g. https://app.example.com/api/plaid/webhook

# 32 random bytes, base64. Encrypts Plaid access tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Anthropic (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
JEFF_MODEL=claude-opus-5-5

# Public URL of this app, used for magic-link redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
